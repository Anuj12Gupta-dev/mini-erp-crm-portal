{
  "info": {
    "name": "Mini ERP + CRM Operations Portal",
    "description": "API collection for the Mini ERP + CRM backend. Set {{baseUrl}} and run 'Login' first to auto-populate {{token}}. Within each folder, run requests top-to-bottom: 'Create' populates the id variable used by the requests below it. Confirm / Cancel / Delete on Challans are alternative terminal actions on the same draft, not meant to all be run in sequence.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "token", "value": "" },
    { "key": "customerId", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "challanId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.token) { pm.collectionVariables.set('token', body.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Customers",
      "item": [
        {
          "name": "List customers",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/customers?page=1&pageSize=20&search=",
              "host": ["{{baseUrl}}"],
              "path": ["customers"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" },
                { "key": "search", "value": "" },
                { "key": "status", "value": "", "disabled": true },
                { "key": "type", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Create customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.id) { pm.collectionVariables.set('customerId', body.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Acme Traders\",\n  \"mobile\": \"9{{$timestamp}}\",\n  \"businessName\": \"Acme\",\n  \"type\": \"WHOLESALE\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/customers", "host": ["{{baseUrl}}"], "path": ["customers"] }
          }
        },
        {
          "name": "Get customer",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/customers/{{customerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["customers", "{{customerId}}"]
            }
          }
        },
        {
          "name": "Update customer",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"ACTIVE\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/customers/{{customerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["customers", "{{customerId}}"]
            }
          }
        },
        {
          "name": "List follow-ups",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/customers/{{customerId}}/follow-ups",
              "host": ["{{baseUrl}}"],
              "path": ["customers", "{{customerId}}", "follow-ups"]
            }
          }
        },
        {
          "name": "Add follow-up",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"note\": \"Called, interested in bulk order\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/customers/{{customerId}}/follow-ups",
              "host": ["{{baseUrl}}"],
              "path": ["customers", "{{customerId}}", "follow-ups"]
            }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?page=1&pageSize=20&lowStock=false",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" },
                { "key": "search", "value": "", "disabled": true },
                { "key": "category", "value": "", "disabled": true },
                { "key": "lowStock", "value": "false" }
              ]
            }
          }
        },
        {
          "name": "Create product",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.id) { pm.collectionVariables.set('productId', body.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Widget\",\n  \"sku\": \"WID-{{$timestamp}}\",\n  \"unitPrice\": 50,\n  \"minStockQty\": 5,\n  \"openingStock\": 100\n}"
            },
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] }
          }
        },
        {
          "name": "Get product",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            }
          }
        },
        {
          "name": "Update product",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"unitPrice\": 55\n}" },
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            }
          }
        },
        {
          "name": "Record stock movement",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 10,\n  \"type\": \"OUT\",\n  \"reason\": \"Sample dispatch\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/stock-movements",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}", "stock-movements"]
            }
          }
        }
      ]
    },
    {
      "name": "Stock Movements",
      "item": [
        {
          "name": "List stock movements",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/stock-movements?page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["stock-movements"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" },
                { "key": "productId", "value": "{{productId}}", "disabled": true }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Challans",
      "item": [
        {
          "name": "List challans",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/challans?page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["challans"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" },
                { "key": "search", "value": "", "disabled": true },
                { "key": "status", "value": "", "disabled": true },
                { "key": "customerId", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Create challan (draft)",
          "description": "Requires {{customerId}} and {{productId}} to already be set — run Customers > Create customer and Products > Create product first.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.id) { pm.collectionVariables.set('challanId', body.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"quantity\": 2 }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/challans", "host": ["{{baseUrl}}"], "path": ["challans"] }
          }
        },
        {
          "name": "Get challan",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/challans/{{challanId}}",
              "host": ["{{baseUrl}}"],
              "path": ["challans", "{{challanId}}"]
            }
          }
        },
        {
          "name": "Update challan (draft only)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"quantity\": 3 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/challans/{{challanId}}",
              "host": ["{{baseUrl}}"],
              "path": ["challans", "{{challanId}}"]
            }
          }
        },
        {
          "name": "Confirm challan",
          "description": "Alternative terminal action — confirms the draft and decrements stock. Run this OR 'Delete challan' OR 'Cancel challan' on a given draft, not all three.",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/challans/{{challanId}}/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["challans", "{{challanId}}", "confirm"]
            }
          }
        },
        {
          "name": "Cancel challan",
          "description": "Alternative terminal action — cancels a draft (no stock impact) or a confirmed challan (restocks its items).",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/challans/{{challanId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["challans", "{{challanId}}", "cancel"]
            }
          }
        },
        {
          "name": "Delete challan (draft only)",
          "description": "Alternative terminal action — only works while the challan is still a draft (409 otherwise).",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/challans/{{challanId}}",
              "host": ["{{baseUrl}}"],
              "path": ["challans", "{{challanId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Cleanup (optional)",
      "item": [
        {
          "name": "Delete product",
          "description": "Runs after Challans, so if 'Create challan (draft)' above still references this product, this correctly fails with 409 (foreign-key restrict) — that's expected, not a bug. Cancel or delete the challan first (see Challans folder) to allow deletion.",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            }
          }
        },
        {
          "name": "Delete customer",
          "description": "Same as 'Delete product' above — fails with 409 while a challan still references this customer.",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/customers/{{customerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["customers", "{{customerId}}"]
            }
          }
        }
      ]
    }
  ]
}
