DATABASE_URL=postgresql://localhost:5432/mini_erp_crm?schema=public
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
PORT=4000

# Optional: only required for the product-image-upload bonus feature (POST /uploads/presign).
# The app runs fine without these — that endpoint just responds 501 until they're set.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
# Optional: override the public URL prefix (e.g. a CloudFront domain in front of the bucket).
# Defaults to the bucket's virtual-hosted-style S3 URL when unset.
S3_PUBLIC_BASE_URL=
